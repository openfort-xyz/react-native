{
  "name": "@openfort/react-native",
  "main": "dist/index.js",
  "version": "2.0.0",
  "license": "MIT",
  "description": "React Native SDK for Openfort platform integration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openfort-xyz/react-native.git"
  },
  "homepage": "https://github.com/openfort-xyz/react-native#readme",
  "bugs": {
    "url": "https://github.com/openfort-xyz/react-native/issues"
  },
  "scripts": {
    "build": "tsc",
    "check": "biome check",
    "clean": "rm -rf dist",
    "changeset": "changeset",
    "changeset:version": "pnpm install --lockfile-only && changeset version",
    "changeset:publish": "pnpm build && changeset publish",
    "check:unused": "pnpm clean && knip",
    "check:fix": "biome check --write --unsafe",
    "lint": "tsc -b && biome lint .",
    "test": "vitest run",
    "link": "pnpm link",
    "unlink": "pnpm unlink",
    "docs:build": "typedoc",
    "size": "size-limit",
    "size:check": "size-limit --ci"
  },
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "dependencies": {
    "@openfort/openfort-js": "^2.1.0",
    "react-native-passkeys": "0.4.1"
  },
  "peerDependencies": {
    "expo-apple-authentication": "*",
    "expo-application": "*",
    "expo-crypto": "*",
    "expo-linking": "*",
    "expo-secure-store": "*",
    "expo-web-browser": "*",
    "react": "*",
    "react-native": "*",
    "react-native-webview": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@types/react": "~18.3.28",
    "buffer": "^5.7.1",
    "expo-apple-authentication": "^7.2.4",
    "expo-application": "^6.1.5",
    "expo-crypto": "14.0.2",
    "expo-linking": "^7.1.7",
    "expo-secure-store": "^14.2.4",
    "expo-web-browser": "^14.2.0",
    "knip": "^5.88.1",
    "react": "^18.3.1",
    "react-native": "0.77.1",
    "react-native-webview": "^13.16.1",
    "size-limit": "^11.2.0",
    "typedoc": "^0.28.19",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "knip": {
    "entry": [
      "src/index.ts!"
    ],
    "ignore": [
      ".github/**",
      ".husky/**",
      "**/dist/**",
      "test/**"
    ],
    "ignoreDependencies": [
      "buffer"
    ],
    "ignoreExportsUsedInFile": true
  },
  "private": false,
  "packageManager": "pnpm@10.19.0",
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "250 KB",
      "ignore": [
        "expo-modules-core"
      ]
    }
  ],
  "pnpm": {
    "auditConfig": {
      "ignoreCves": [
        "CVE-2025-14505"
      ],
      "ignoreGhsas": [
        "GHSA-mh99-v99m-4gvg"
      ]
    },
    "overrides": {
      "glob@>=10.3.7 <=11.0.3": ">=11.1.0",
      "node-forge@<1.3.2": ">=1.3.2",
      "@xmldom/xmldom@<0.9.10": ">=0.9.10",
      "axios@<1.16.0": ">=1.16.0",
      "form-data@<4.0.6": ">=4.0.6",
      "shell-quote@<1.8.4": ">=1.8.4",
      "linkify-it@<5.0.2": "5.0.2",
      "markdown-it@<14.2.0": ">=14.2.0",
      "tmp@<0.2.6": ">=0.2.6",
      "@babel/core@<7.29.6": ">=7.29.6",
      "uuid@<11.1.1": ">=11.1.1",
      "postcss@<8.5.18": ">=8.5.18",
      "brace-expansion@<1.1.16": "1.1.16",
      "brace-expansion@>=5.0.0 <5.0.8": ">=5.0.8",
      "test-exclude@<8": "8.0.0",
      "js-yaml@<3.15.0": "3.15.0",
      "js-yaml@>=4.0.0 <4.2.0": ">=4.2.0 <5",
      "js-yaml@>=5.0.0 <5.2.2": ">=5.2.2",
      "ws@>=6.0.0 <6.2.4": ">=6.2.4",
      "ws@>=7.0.0 <7.5.11": ">=7.5.11",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0"
    }
  }
}
