auto-install-peers=false
enable-pre-post-scripts=true
strict-peer-dependencies=false
save-exact=true
ignore-scripts=true
provenance=true

# First-party packages are exempt from the publish-age cooldown. The cooldown
# guards against compromised third-party releases; we control these publishes.
minimumReleaseAgeExclude[]=@openfort/openfort-js